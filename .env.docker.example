# Copy to .env before running `npm run docker:dev`.

# Public ports exposed by docker-compose.yml.
CLIENT_PORT=5173
SERVER_PORT=3001
MEDIA_SERVER_PORT=3002
PROMETHEUS_PORT=9090
GRAFANA_PORT=3003

# Browser-facing local service URLs.
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws
VITE_MEDIA_WS_URL=ws://localhost:3002/rtmp
VITE_INVITE_BASE_URL=http://localhost:5173

# CORS / WebSocket origin checks for the local client.
CLIENT_URLS=http://localhost:5173

# Shared between the signaling server and media server for RTMP relay tokens.
# Use a longer private value when testing anything beyond local development.
LIVE_STREAM_TOKEN_SECRET=local-development-live-stream-token-secret

# Optional PostgreSQL room snapshots for restart-safe studios.
# Leave blank for memory-only local development.
DATABASE_URL=
PGSSLMODE=disable
ROOM_PERSISTENCE_DISABLED=false

# Optional integrations.
VITE_GOOGLE_CLIENT_ID=
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Optional WebRTC ICE configuration.
ICE_TRANSPORT_POLICY=all
ICE_SERVERS_JSON=
STUN_URLS=
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_CREDENTIAL_TYPE=

# Optional FFmpeg override. Leave empty to use ffmpeg-static from media-server.
FFMPEG_PATH=

# Optional S3-compatible recording export storage for media-server artifacts.
# Works with AWS S3, Cloudflare R2, Backblaze B2 S3, MinIO, and similar APIs.
RECORDING_STORAGE_ENDPOINT=
RECORDING_STORAGE_REGION=us-east-1
RECORDING_STORAGE_BUCKET=
RECORDING_STORAGE_ACCESS_KEY_ID=
RECORDING_STORAGE_SECRET_ACCESS_KEY=
RECORDING_STORAGE_FORCE_PATH_STYLE=true
RECORDING_STORAGE_PREFIX=livestream-studio
RECORDING_STORAGE_PUBLIC_BASE_URL=

# Local monitoring profile credentials.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
