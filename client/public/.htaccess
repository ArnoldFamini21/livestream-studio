RewriteEngine On
RewriteBase /

# Module scripts must be served as JavaScript; browsers refuse text/plain.
AddType text/javascript .js .mjs
# WebAssembly (RNNoise, in-browser Whisper's onnxruntime, MediaPipe face
# detection) compiles while it downloads only when served as application/wasm.
AddType application/wasm .wasm

<IfModule mod_headers.c>
  # Security headers.
  #
  # Content-Security-Policy: scripts only from this site plus the three
  # third-party script hosts the studio loads on demand (Google sign-in and
  # Drive/YouTube APIs, and the version-pinned MediaPipe virtual background on
  # jsDelivr). 'wasm-unsafe-eval' lets MediaPipe compile its WebAssembly; no
  # JavaScript eval is allowed. Network calls stay open to any https:/wss:
  # host because the API, media server and recording object storage live on
  # owner-configured domains (Render, Cloudflare R2, etc.). WebRTC/TURN traffic
  # is not governed by CSP. Images, video and audio may come from blob:/data:
  # (local media, recordings) or any https: host (media added by URL); widget
  # overlays and PDF previews are framed from https:/blob:. Inline style
  # attributes are used throughout the React UI, hence style-src 'unsafe-inline'.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://accounts.google.com https://apis.google.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://accounts.google.com https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https: wss: blob: data:; worker-src 'self' blob: https://cdn.jsdelivr.net; child-src 'self' blob: https:; frame-src 'self' blob: data: https:; object-src 'self' blob:; manifest-src 'self'; base-uri 'self'; form-action 'self' https://accounts.google.com; frame-ancestors 'self'"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  # Camera, microphone and screen sharing only for this site (not for framed widgets).
  Header always set Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=(), usb=(), serial=(), hid=()"

  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"

  <FilesMatch "\.(?:css|js|mjs|json|wasm|png|jpe?g|gif|svg|webp|avif|ico|woff2?)$">
    Header unset Pragma
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 1 year"
  ExpiresByType application/wasm "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
