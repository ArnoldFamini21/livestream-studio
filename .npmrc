# @huggingface/transformers (in-browser Whisper, client only) depends on
# onnxruntime-node, whose postinstall downloads CUDA binaries from nuget.org on
# every Linux install (Render, Docker, CI) and fails the install when that feed
# is unreachable. The browser build never loads onnxruntime-node, so skip it.
onnxruntime-node-install=skip
