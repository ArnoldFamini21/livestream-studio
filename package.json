{
  "name": "livestream-studio",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "media-server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:media": "npm run dev --workspace=media-server",
    "docker:config": "docker compose config",
    "docker:config:monitoring": "docker compose --profile monitoring config",
    "docker:dev": "docker compose up --build",
    "docker:monitoring": "docker compose --profile monitoring up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "production:check": "node scripts/check-production.mjs",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces && node --test scripts/*.test.mjs",
    "lint": "npm run lint --workspaces",
    "test:e2e": "node --test --test-concurrency=1 e2e/*.test.mjs",
    "test:recording-soak": "node e2e/recording-soak.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "playwright-core": "1.65.0",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "qs": "~6.16.2",
    "pptx-preview": {
      "echarts": "^6.1.0",
      "uuid": "^11.1.1"
    }
  }
}
